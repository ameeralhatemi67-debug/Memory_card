<?xml version="1.0" encoding="utf-8"?>
<!-- The light crosses the card in the first third of the loop, then rests. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="7000"
    android:repeatCount="-1">
    <propertyValuesHolder android:propertyName="translateX">
        <keyframe android:fraction="0" android:value="-80" />
        <keyframe android:fraction="0.22" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="290" />
        <keyframe android:fraction="1" android:value="290" />
    </propertyValuesHolder>
</objectAnimator>
