<?xml version="1.0" encoding="utf-8"?>
<!-- The light crosses the bar, then rests; each bar has its own loop so they never sweep in step. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="7000"
    android:repeatCount="-1">
    <propertyValuesHolder android:propertyName="translateX">
        <keyframe android:fraction="0" android:value="-90" />
        <keyframe android:fraction="0.2" android:interpolator="@android:interpolator/fast_out_slow_in" android:value="560" />
        <keyframe android:fraction="1" android:value="560" />
    </propertyValuesHolder>
</objectAnimator>
