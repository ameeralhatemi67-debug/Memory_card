<?xml version="1.0" encoding="utf-8"?>
<!-- A flame that never quite holds still: three slightly out-of-step wobbles. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
    <objectAnimator
        android:duration="430"
        android:interpolator="@android:interpolator/accelerate_decelerate"
        android:propertyName="scaleY"
        android:repeatCount="-1"
        android:repeatMode="reverse"
        android:valueFrom="1.0"
        android:valueTo="1.13"
        android:valueType="floatType" />
    <objectAnimator
        android:duration="590"
        android:interpolator="@android:interpolator/accelerate_decelerate"
        android:propertyName="scaleX"
        android:repeatCount="-1"
        android:repeatMode="reverse"
        android:valueFrom="1.0"
        android:valueTo="0.9"
        android:valueType="floatType" />
    <objectAnimator
        android:duration="810"
        android:interpolator="@android:interpolator/accelerate_decelerate"
        android:propertyName="rotation"
        android:repeatCount="-1"
        android:repeatMode="reverse"
        android:valueFrom="-4"
        android:valueTo="4"
        android:valueType="floatType" />
</set>
