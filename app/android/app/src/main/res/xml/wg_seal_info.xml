<?xml version="1.0" encoding="utf-8"?>
<!-- Daily goal seal: 1×1 up to 2×2 and beyond; redrawn every 30 min and at 04:00 / 18:00 (scheduled by the app). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/wg_seal_desc"
    android:initialLayout="@layout/wg_loading"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/wg_seal_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen|keyguard" />
