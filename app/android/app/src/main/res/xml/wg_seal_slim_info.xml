<?xml version="1.0" encoding="utf-8"?>
<!-- Daily goal seal, slim: a 1×1 pill, stretching to 2×1 and no further. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/wg_seal_slim_desc"
    android:initialLayout="@layout/wg_loading"
    android:maxResizeWidth="160dp"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/wg_prev_seal_slim"
    android:resizeMode="horizontal"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen|keyguard" />
