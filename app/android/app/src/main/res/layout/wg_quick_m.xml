<?xml version="1.0" encoding="utf-8"?>
<!-- Quick card, 2×2: the prompt, Reveal, then Again / Got it. Every Quick card layout carries the same
     ids (unused ones stay gone) so one binding fills them all. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_paper"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/q_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/q_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <TextView android:id="@+id/q_deck" style="@style/WgText" android:layout_width="wrap_content" android:layout_height="wrap_content" />

            <TextView android:id="@+id/q_count" style="@style/WgText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/q_label"
            style="@style/WgText.Caps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="9.5sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/q_front_text"
                android:adjustViewBounds="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:tint="@color/mc_ink" />

            <ImageView
                android:id="@+id/q_front_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </FrameLayout>

        <TextView android:id="@+id/q_example" style="@style/WgText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />

        <TextView android:id="@+id/q_hidden" style="@style/WgText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />

        <LinearLayout
            android:id="@+id/q_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/wg_box_soft"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/q_back_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tint="@color/mc_ink" />

            <ImageView
                android:id="@+id/q_back_img"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView android:id="@+id/q_hook" style="@style/WgText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/q_reveal"
            style="@style/WgButton"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:background="@drawable/wg_btn_ink"
            android:text="Reveal"
            android:textColor="@color/mc_on_ink" />

        <LinearLayout
            android:id="@+id/q_grades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/q_again"
                style="@style/WgButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:background="@drawable/wg_btn_again"
                android:text="Again"
                android:textColor="@color/mc_graphite"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/q_good"
                style="@style/WgButton"
                android:layout_width="0dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/wg_btn_good"
                android:text="Got it"
                android:textColor="@color/mc_graphite"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/wg_quick_empty" />
</FrameLayout>
