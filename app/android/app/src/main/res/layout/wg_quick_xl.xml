<?xml version="1.0" encoding="utf-8"?>
<!-- Quick card, 4×3: an ink card face with the prompt, the answer below it, then the buttons. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_paper"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/q_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/q_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/q_deck"
                style="@style/WgText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/q_count"
                style="@style/WgText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="@drawable/wg_face_ink"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/q_label"
                style="@style/WgText.Caps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mc_muted_on_ink" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/q_front_text"
                    android:adjustViewBounds="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:scaleType="centerInside"
                    android:tint="@color/mc_on_ink" />

                <ImageView
                    android:id="@+id/q_front_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/q_example"
                style="@style/WgText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/mc_muted_on_ink"
                android:textSize="12.5sp"
                android:textStyle="italic" />
        </LinearLayout>

        <TextView
            android:id="@+id/q_hidden"
            style="@style/WgText"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/wg_box_dashed"
            android:gravity="center"
            android:text="Answer hidden"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/q_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/wg_box_soft"
            android:minHeight="58dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/q_back_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tint="@color/mc_ink" />

            <ImageView
                android:id="@+id/q_back_img"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <TextView
                android:id="@+id/q_hook"
                style="@style/WgText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/q_reveal"
            style="@style/WgButton"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:background="@drawable/wg_btn_ink"
            android:text="Reveal"
            android:textColor="@color/mc_on_ink" />

        <LinearLayout
            android:id="@+id/q_grades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/q_again"
                style="@style/WgButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:background="@drawable/wg_btn_again"
                android:text="Again"
                android:textColor="@color/mc_graphite" />

            <TextView
                android:id="@+id/q_good"
                style="@style/WgButton"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/wg_btn_good"
                android:text="Got it"
                android:textColor="@color/mc_graphite" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/wg_quick_empty" />
</FrameLayout>
