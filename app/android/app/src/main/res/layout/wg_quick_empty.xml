<?xml version="1.0" encoding="utf-8"?>
<!-- Quick card with nothing to show: everything recalled, or the app not opened yet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/q_empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:visibility="gone">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="30dp"
        android:importantForAccessibility="no"
        android:src="@drawable/wg_logo"
        android:tint="@color/mc_ink" />

    <ImageView
        android:id="@+id/q_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:tint="@color/mc_ink" />

    <TextView
        android:id="@+id/q_empty_sub"
        style="@style/WgText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15" />
</LinearLayout>
