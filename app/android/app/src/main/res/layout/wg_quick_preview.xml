<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_paper"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        style="@style/WgText.Caps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="noun · masculine" />

    <TextView
        style="@style/WgText.Bold"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="der Apfel"
        android:textSize="28sp" />

    <TextView
        style="@style/WgButton"
        android:layout_width="match_parent"
        android:background="@drawable/wg_btn_ink"
        android:text="Reveal"
        android:textColor="@color/mc_on_ink" />
</LinearLayout>
