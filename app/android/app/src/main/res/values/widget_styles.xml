<?xml version="1.0" encoding="utf-8"?>
<!-- Widget text. Barlow Semi Condensed is not on the phone, so the system's condensed face stands in;
     display text (Bernard) is drawn as tinted bitmaps by the widget code. -->
<resources>
    <style name="WgText">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/mc_muted</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="WgText.Bold">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/mc_ink</item>
    </style>


    <!-- A moving piece of a drawn widget: a ProgressBar that is white, gone, and placed from code. -->
    <style name="WgFx">
        <item name="android:layout_width">10dp</item>
        <item name="android:layout_height">10dp</item>
        <item name="android:layout_gravity">top|left</item>
        <item name="android:indeterminate">true</item>
        <item name="android:indeterminateOnly">true</item>
        <item name="android:minWidth">1dp</item>
        <item name="android:minHeight">1dp</item>
        <item name="android:maxWidth">600dp</item>
        <item name="android:maxHeight">600dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- A tap target: gone until a scene places it over a button or a row. -->
    <style name="WgHit">
        <item name="android:layout_width">10dp</item>
        <item name="android:layout_height">10dp</item>
        <item name="android:layout_gravity">top|left</item>
        <item name="android:background">@drawable/wg_ripple_14</item>
        <item name="android:visibility">gone</item>
    </style>

</resources>
