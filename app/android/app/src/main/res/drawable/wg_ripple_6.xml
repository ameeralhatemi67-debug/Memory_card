<?xml version="1.0" encoding="utf-8"?>
<!-- The press feedback of a tap target: a soft grey ripple inside rounded corners. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#4D808080">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</ripple>
