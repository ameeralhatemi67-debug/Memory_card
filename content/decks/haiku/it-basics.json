  "description": "Greet people, ask simple questions, order food and drink, and name everyday things in Italian, with the right article for each noun.",
  "cards": [
    { "front": "ciao", "back": "hi / bye (informal)", "label": "greeting", "example": "Ciao, come stai?", "hook": "Works for hello and goodbye, but only with friends." },
    { "front": "grazie", "back": "thank you", "label": "phrase", "example": "Grazie mille per il regalo.", "hook": "" },
    { "front": "per favore", "back": "please", "label": "phrase", "example": "Un caffè, per favore.", "hook": "" },
    { "front": "sì", "back": "yes", "label": "word", "example": "Sì, volentieri.", "hook": "Always written with an accent: sì, not si." },
    { "front": "no", "back": "no", "label": "word", "example": "No, grazie.", "hook": "" },
    { "front": "buongiorno", "back": "good morning / hello", "label": "greeting", "example": "Buongiorno, signora!", "hook": "" },
    { "front": "buonasera", "back": "good evening", "label": "greeting", "example": "Buonasera a tutti!", "hook": "" },
    { "front": "buonanotte", "back": "good night", "label": "greeting", "example": "Buonanotte, a domani!", "hook": "" },
    { "front": "scusi", "back": "excuse me (formal)", "label": "phrase", "example": "Scusi, è libero questo posto?", "hook": "" },
    { "front": "scusa", "back": "sorry / excuse me (informal)", "label": "phrase", "example": "Scusa, dov'è la stazione?", "hook": "Scusa is informal; use scusi with strangers." },
    { "front": "prego", "back": "you're welcome / go ahead", "label": "phrase", "example": "Prego, si accomodi.", "hook": "Replies to grazie, and also means 'after you'." },
    { "front": "come stai?", "back": "how are you? (informal)", "label": "phrase", "example": "Ciao, come stai oggi?", "hook": "" },
    { "front": "bene", "back": "well / fine", "label": "adverb", "example": "Sto bene, grazie.", "hook": "The usual answer to come stai?: Sto bene." },
    { "front": "mi chiamo", "back": "my name is", "label": "phrase", "example": "Ciao, mi chiamo Luca.", "hook": "" },
    { "front": "piacere", "back": "nice to meet you", "label": "phrase", "example": "Piacere di conoscerti!", "hook": "" },
    { "front": "non capisco", "back": "I don't understand", "label": "phrase", "example": "Mi scusi, non capisco.", "hook": "" },
    { "front": "parla inglese?", "back": "do you speak English? (formal)", "label": "question", "example": "Mi scusi, parla inglese?", "hook": "" },
    { "front": "dov'è", "back": "where is", "label": "question", "example": "Scusi, dov'è il bagno?", "hook": "The apostrophe replaces the dropped e of dove." },
    { "front": "quanto costa?", "back": "how much does it cost?", "label": "question", "example": "Quanto costa questo libro?", "hook": "" },
    { "front": "arrivederci", "back": "goodbye (formal)", "label": "greeting", "example": "Arrivederci, a presto!", "hook": "Formal goodbye; ciao is for friends." },
    { "front": "l'acqua", "back": "water", "label": "noun · feminine", "example": "Vorrei un bicchiere d'acqua.", "hook": "Feminine: la acqua becomes l'acqua before a vowel." },
    { "front": "il pane", "back": "bread", "label": "noun · masculine", "example": "Il pane è ancora caldo.", "hook": "" },
    { "front": "il caffè", "back": "coffee", "label": "noun · masculine", "example": "Prendo un caffè al bar.", "hook": "" },
    { "front": "il vino", "back": "wine", "label": "noun · masculine", "example": "Un bicchiere di vino rosso, per favore.", "hook": "" },
    { "front": "il latte", "back": "milk", "label": "noun · masculine", "example": "Il latte è nel frigo.", "hook": "" },
    { "front": "la mela", "back": "apple", "label": "noun · feminine", "example": "Mangio una mela ogni giorno.", "hook": "Most nouns ending in -a are feminine (exception: il problema)." },
    { "front": "la casa", "back": "house / home", "label": "noun · feminine", "example": "Torno a casa alle sei.", "hook": "" },
    { "front": "il libro", "back": "book", "label": "noun · masculine", "example": "Leggo un libro ogni settimana.", "hook": "" },
    { "front": "la scuola", "back": "school", "label": "noun · feminine", "example": "Vado a scuola in bicicletta.", "hook": "" },
    { "front": "il gatto", "back": "cat", "label": "noun · masculine", "example": "Il gatto dorme sul divano.", "hook": "" },
    { "front": "il cane", "back": "dog", "label": "noun · masculine", "example": "Il cane corre nel parco.", "hook": "" },
    { "front": "la macchina", "back": "car", "label": "noun · feminine", "example": "La mia macchina è blu.", "hook": "" },
